{
  "name": "@agent-axiom/streamsplit",
  "version": "0.1.0",
  "description": "Find and shrink byte-chunking bugs in streaming parsers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-axiom/streamsplit.git"
  },
  "bugs": {
    "url": "https://github.com/agent-axiom/streamsplit/issues"
  },
  "keywords": [
    "streaming",
    "parser",
    "testing",
    "utf8",
    "sse",
    "ndjson",
    "fuzzing"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm test && npm run test:types && npm run test:package",
    "demo": "npm run build && node examples/demo.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
